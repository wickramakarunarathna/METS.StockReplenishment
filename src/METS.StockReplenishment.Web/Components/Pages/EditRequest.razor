@page "/requests/{Id:int}/edit"
@using Microsoft.AspNetCore.Authorization
@using METS.StockReplenishment.Core.Interfaces
@attribute [Authorize(Roles = "Worker")]
@inject HttpClient Http
@inject IReplenishmentRequestService ReplenishmentRequestService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Edit Request @(_existingRequest?.RequestNumber ?? $"#{Id}")</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-center align-center my-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="ml-3">Loading request...</MudText>
    </div>
}
else if (_existingRequest == null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">
        Request with ID @Id could not be found.
    </MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" OnClick="@(() => NavigationManager.NavigateTo("/"))">
        Back to Requests List
    </MudButton>
}
else if (!string.Equals(_existingRequest.Status, "Draft", StringComparison.OrdinalIgnoreCase))
{
    <MudAlert Severity="Severity.Warning" Class="my-4">
        Only draft requests can be edited. This request is currently in <strong>@_existingRequest.Status</strong> status.
    </MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" OnClick="@(() => NavigationManager.NavigateTo($"/requests/{Id}"))">
        Back to Request Details
    </MudButton>
}
else
{
    <div class="d-flex align-center justify-space-between mb-4">
        <div class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo($"/requests/{Id}"))" aria-label="Back" Class="mr-2" />
            <div>
                <MudText Typo="Typo.h5">Edit Draft Request: @_existingRequest.RequestNumber</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Requested by: @_existingRequest.RequestedBy on @_existingRequest.RequestedAt.ToLocalTime().ToString("g")</MudText>
            </div>
        </div>
        <MudChip T="string" Color="Color.Default" Variant="Variant.Filled">Draft</MudChip>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
            @_errorMessage
        </MudAlert>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="3">
            <!-- Request Header Info Card -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Request Details</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="3">
                                <MudTextField Value="@_existingRequest.RequestedBy" 
                                              Label="Requested By" 
                                              ReadOnly="true" 
                                              Disabled="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="6">
                                <MudAutocomplete T="StockLocationOptionDto"
                                                 Label="Stock Location"
                                                 Value="_selectedLocation"
                                                 ValueChanged="OnLocationChanged"
                                                 SearchFunc="SearchLocations"
                                                 ToStringFunc="LocationToString"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 Required="true"
                                                 RequiredError="Stock location is required"
                                                 Placeholder="Select or type a stock location" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="RequestPriority" 
                                           @bind-Value="_model.Priority" 
                                           For="@(() => _model.Priority)"
                                           Label="Priority">
                                    @foreach (var priority in Enum.GetValues<RequestPriority>())
                                    {
                                        <MudSelectItem Value="@priority">@priority</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Line Items Card -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.h6">Line Items</MudText>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Primary" 
                                           StartIcon="@Icons.Material.Filled.Add" 
                                           Size="Size.Small" 
                                           OnClick="AddLineItem">
                                    Add Item
                                </MudButton>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (!_model.LineItems.Any())
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                Please add at least one line item to this request.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="_model.LineItems" Dense="true" Elevation="0" Striped="true">
                                <HeaderContent>
                                    <MudTh Style="width: 50px;">#</MudTh>
                                    <MudTh>Article</MudTh>
                                    <MudTh Style="width: 180px; text-align: right">Requested Quantity</MudTh>
                                    <MudTh Style="width: 80px; text-align: center">Action</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="lineItem">
                                    <MudTd DataLabel="#">@(_model.LineItems.IndexOf(lineItem) + 1)</MudTd>
                                    <MudTd DataLabel="Article">
                                        <MudAutocomplete T="string"
                                                         Value="lineItem.ArticleNumber"
                                                         ValueChanged="@(value => OnArticleChanged(lineItem, value))"
                                                         SearchFunc="@((value, token) => SearchArticles(value, token, lineItem))"
                                                         ToStringFunc="ArticleToString"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         ResetValueOnEmptyText="true"
                                                         Required="true"
                                                         RequiredError="Article is required"
                                                         Placeholder="Select or type an article"
                                                         Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd DataLabel="Requested Quantity" Style="text-align: right">
                                        <MudNumericField @bind-Value="lineItem.RequestedQuantity" 
                                                         Min="0.01m" 
                                                         Step="1m" 
                                                         Format="F2" 
                                                         Margin="Margin.Dense" />
                                    </MudTd>
                                    <MudTd DataLabel="Action" Style="text-align: center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="@(() => RemoveLineItem(lineItem))" 
                                                       aria-label="Remove Item" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                    <MudCardActions Class="d-flex justify-space-between pa-4">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Secondary" 
                                   OnClick="@(() => NavigationManager.NavigateTo($"/requests/{Id}"))">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Save" 
                                   Disabled="@_isSaving" 
                                   ButtonType="ButtonType.Submit">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Changes</span>
                            }
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ReplenishmentRequestDto? _existingRequest;
    private UpdateReplenishmentRequestDto _model = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private StockLocationOptionDto? _selectedLocation;
    private List<StockLocationOptionDto> _stockLocations = new();
    private List<ArticleOptionDto> _articleOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStockLocationsAsync();
        await LoadRequestAsync();
    }

    private async Task LoadStockLocationsAsync()
    {
        try
        {
            var locations = await Http.GetFromJsonAsync<List<StockLocationOptionDto>>("/api/replenishmentrequests/location-options");
            if (locations != null)
            {
                _stockLocations = locations;
            }

            _articleOptions = await ReplenishmentRequestService.GetDistinctArticleOptionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dropdown options: {ex.Message}", Severity.Warning);
        }
    }

    private async Task LoadRequestAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _existingRequest = await Http.GetFromJsonAsync<ReplenishmentRequestDto>($"/api/replenishmentrequests/{Id}");
            if (_existingRequest != null && string.Equals(_existingRequest.Status, "Draft", StringComparison.OrdinalIgnoreCase))
            {
                RequestPriority priority = RequestPriority.Normal;
                if (Enum.TryParse<RequestPriority>(_existingRequest.Priority, out var parsedPriority))
                {
                    priority = parsedPriority;
                }

                _model = new UpdateReplenishmentRequestDto
                {
                    StockLocationCode = _existingRequest.StockLocationCode,
                    StockLocationName = _existingRequest.StockLocationName,
                    Priority = priority,
                    LineItems = _existingRequest.LineItems.Select(li => new CreateLineItemDto
                    {
                        ArticleNumber = li.ArticleNumber,
                        Description = li.Description,
                        RequestedQuantity = li.RequestedQuantity
                    }).ToList()
                };

                _selectedLocation = _stockLocations.FirstOrDefault(l => l.Code == _model.StockLocationCode);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading request: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnLocationChanged(StockLocationOptionDto? location)
    {
        _selectedLocation = location;
        _model.StockLocationCode = location?.Code ?? string.Empty;
        _model.StockLocationName = location?.Name ?? string.Empty;

        return Task.CompletedTask;
    }

    private void AddLineItem()
    {
        if (_articleOptions.Any() && _model.LineItems.Count(li => !string.IsNullOrWhiteSpace(li.ArticleNumber)) >= _articleOptions.Count)
        {
            Snackbar.Add("All available articles are already selected.", Severity.Warning);
            return;
        }

        _model.LineItems.Add(new CreateLineItemDto
        {
            ArticleNumber = string.Empty,
            Description = string.Empty,
            RequestedQuantity = 1.00m
        });
    }

    private void OnArticleChanged(CreateLineItemDto lineItem, string? articleNumber)
    {
        var normalizedArticleNumber = articleNumber?.Trim() ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(normalizedArticleNumber) &&
            _model.LineItems.Any(li => !ReferenceEquals(li, lineItem) &&
                string.Equals(li.ArticleNumber, normalizedArticleNumber, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add($"Article '{normalizedArticleNumber}' is already selected in another line item.", Severity.Warning);
            return;
        }

        lineItem.ArticleNumber = normalizedArticleNumber;

        var selectedArticle = _articleOptions.FirstOrDefault(a =>
            string.Equals(a.ArticleNumber, normalizedArticleNumber, StringComparison.OrdinalIgnoreCase));
        lineItem.Description = selectedArticle?.Description ?? string.Empty;
    }

    private Task<IEnumerable<StockLocationOptionDto>> SearchLocations(string value, CancellationToken token)
    {
        IEnumerable<StockLocationOptionDto> results = _stockLocations;

        if (!string.IsNullOrWhiteSpace(value))
        {
            results = results.Where(l =>
                l.Code.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchArticles(string value, CancellationToken token, CreateLineItemDto currentLineItem)
    {
        IEnumerable<ArticleOptionDto> results = _articleOptions;
        var alreadySelected = _model.LineItems
            .Where(li => !ReferenceEquals(li, currentLineItem) && !string.IsNullOrWhiteSpace(li.ArticleNumber))
            .Select(li => li.ArticleNumber)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        results = results.Where(a => !alreadySelected.Contains(a.ArticleNumber));

        if (!string.IsNullOrWhiteSpace(value))
        {
            results = results.Where(a =>
                a.ArticleNumber.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                a.Description.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(results.Select(a => a.ArticleNumber));
    }

    private static string LocationToString(StockLocationOptionDto option)
        => option is null ? string.Empty : $"{option.Code} - {option.Name}";

    private string ArticleToString(string articleNumber)
    {
        var selectedArticle = _articleOptions.FirstOrDefault(a =>
            string.Equals(a.ArticleNumber, articleNumber, StringComparison.OrdinalIgnoreCase));

        return selectedArticle is null ? articleNumber : $"{selectedArticle.ArticleNumber} - {selectedArticle.Description}";
    }

    private void RemoveLineItem(CreateLineItemDto item)
    {
        if (_model.LineItems.Count > 1)
        {
            _model.LineItems.Remove(item);
        }
        else
        {
            Snackbar.Add("A request must contain at least one line item.", Severity.Warning);
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.StockLocationCode) || string.IsNullOrWhiteSpace(_model.StockLocationName))
        {
            _errorMessage = "Stock location is required.";
            return;
        }

        if (!_model.LineItems.Any())
        {
            _errorMessage = "At least one line item is required.";
            return;
        }

        for (int i = 0; i < _model.LineItems.Count; i++)
        {
            var item = _model.LineItems[i];
            if (string.IsNullOrWhiteSpace(item.ArticleNumber))
            {
                _errorMessage = $"Line item #{i + 1}: Article Number is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(item.Description))
            {
                _errorMessage = $"Line item #{i + 1}: Description is required.";
                return;
            }
            if (item.RequestedQuantity <= 0)
            {
                _errorMessage = $"Line item #{i + 1}: Requested quantity must be greater than zero.";
                return;
            }

            if (_model.LineItems
                .Where((_, idx) => idx != i)
                .Any(li => string.Equals(li.ArticleNumber, item.ArticleNumber, StringComparison.OrdinalIgnoreCase)))
            {
                _errorMessage = $"Line item #{i + 1}: Article is already selected in another line item.";
                return;
            }
        }

        _isSaving = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"/api/replenishmentrequests/{Id}", _model);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Request updated successfully!", Severity.Success);
                NavigationManager.NavigateTo($"/requests/{Id}");
            }
            else
            {
                var serverError = await TryReadErrorAsync(response);
                _errorMessage = serverError ?? $"Failed to update request ({response.StatusCode}).";
                Snackbar.Add(_errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string?> TryReadErrorAsync(HttpResponseMessage response)
    {
        if (response.Content is null)
            return null;

        var contentType = response.Content.Headers.ContentType?.MediaType;
        var rawContent = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(rawContent))
            return null;

        if (!string.Equals(contentType, "application/json", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(contentType, "text/json", StringComparison.OrdinalIgnoreCase)
            && !rawContent.TrimStart().StartsWith("{", StringComparison.Ordinal))
        {
            return rawContent;
        }

        try
        {
            var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(rawContent);
            return errorObj?.Error ?? rawContent;
        }
        catch (System.Text.Json.JsonException)
        {
            return rawContent;
        }
    }

    private class ErrorResponse
    {
        public string? Error { get; set; }
    }
}